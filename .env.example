# Backend environment variables. Set real values in the hosting dashboard,
# never commit them. MONGODB_URI can point to local MongoDB for development or
# MongoDB Atlas for production.
NODE_ENV=development
MONGODB_URI="mongodb://127.0.0.1:27017/temple_ease"
JWT_SECRET=""
PORT=3000
CLIENT_URL="http://localhost:3000"

# Set these only for the first production startup when Atlas has no admin user.
# The password must be at least 12 characters; remove these values after setup.
INITIAL_ADMIN_NAME=""
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PHONE=""
INITIAL_ADMIN_PASSWORD=""

# Vercel build-time setting. Leave blank for same-origin local development;
# set to the Render API origin when building the production frontend.
VITE_API_BASE_URL=""
